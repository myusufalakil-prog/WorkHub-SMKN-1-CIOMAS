# ========================================================
# WORKHUB - ENVIRONMENT PRODUCTION (VERCEL + SUPABASE)
# Salin nilai-nilai ini ke tab Settings -> Environment Variables di Vercel Dashboard
# ========================================================

APP_NAME="WORKHUB SMKN 1 Ciomas"
APP_ENV=production
APP_KEY=base64:nxEZY8d0BVdKG0B3verD5pzda+pRiDihhu009Y4tWq0=
APP_DEBUG=false
APP_URL=https://nama-proyek-anda.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# Storage & Cache Khusus Serverless Vercel (/tmp)
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
VIEW_COMPILED_PATH=/tmp/views

SESSION_DRIVER=cookie
CACHE_STORE=array
LOG_CHANNEL=stderr

# ========================================================
# KONEKSI DATABASE SUPABASE (POSTGRESQL)
# Ambil dari Supabase: Project Settings -> Database -> Connection string
# ========================================================
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_SSLMODE=require
